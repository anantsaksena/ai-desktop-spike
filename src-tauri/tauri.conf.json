{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ai-desktop-spike",
  "version": "0.1.0",
  "identifier": "com.aidesktop.spike",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "AI Desktop Spike",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": [
      "tiny-model.gguf"
    ],
    "externalBin": [
      "bin/aidesk-backend",
      "bin/aidesk-llama-server"
    ],
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Private, offline document assistant",
    "linux": {
      "deb": {
        "section": "utils"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
